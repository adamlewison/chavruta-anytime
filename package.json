{
  "name": "chavruta-anytime-2026",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:arch": "node scripts/check-architecture.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:arch",
    "prepare": "husky",
    "db:push": "tsx src/db/drizzle.ts push",
    "db:generate": "tsx src/db/drizzle.ts generate",
    "db:migrate": "tsx --env-file .env.local src/db/run-migrations.ts",
    "db:clear": "tsx --env-file .env.local src/db/clear-db.ts",
    "db:functions": "tsx --env-file .env.local src/db/apply-functions.ts",
    "db:seed": "tsx --env-file .env.local src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup": "pnpm db:push && pnpm db:functions"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.51.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.3.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.38.0",
    "livekit-client": "^2.19.1",
    "livekit-server-sdk": "^2.15.4",
    "lucide-react": "^1.14.0",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.11",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "posthog-js": "^1.372.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "rrule": "^2.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
