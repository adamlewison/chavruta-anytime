# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local

# --- Database (Neon Postgres) ---
# Create a free project at https://neon.tech and use its connection string.
# The app uses the HTTP driver (@neondatabase/serverless), so this must be
# a Neon endpoint (or a neon-local proxy), not a plain local Postgres URL.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=hello@chavrutaanytime.com

# --- Video/voice (LiveKit) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- File uploads (Vercel Blob) ---
# Auto-injected on Vercel; required locally.
BLOB_READ_WRITE_TOKEN=

# --- Cron ---
# Bearer token the Vercel cron endpoints check for. Any random string.
CRON_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
